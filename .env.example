# Copy to .env — never commit real keys.
SITE_URL=https://thecentury.in
DB_PATH=century.db

# Business gates (set by the MD)
SALES_OPEN=false
AVG_ORDER_VALUE_INR=
MONTHLY_PAID_BUDGET_INR=

# Sarvam AI (language: STT/TTS/translate/chat)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Meta Graph API (Instagram/Facebook publishing + comments)
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_FB_PAGE_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ROI assumptions (editable)
HOURLY_COST_INR=300
MINUTES_PER_POST=45
MINUTES_PER_REPLY=4
MINUTES_PER_CALL=6
MINUTES_PER_LEAD_FOLLOWUP=10
MINUTES_PER_SITE_CHECK=5

# Dashboard auth (simple shared token for the API; leave blank for local dev)
DASHBOARD_TOKEN=
